{
    "FastApi": {
        "Host": "${FASTAPI_HOST}",
        "Port": ${FASTAPI_PORT}
    },
    "CodeBuilder": {
        "CodebaseStagingDirectory": "${CODE_STAGING_DIRECTORY}",
        "CodebaseDirectory": "${CODE_DIRECTORY}",
        "CodebaseBuildDirectory": "${CODE_BUILD_DIRECTORY}",
        "CodeBuilderType": "${CODE_BUILDER_TYPE}"
    },
    "KeypointNotification": {
        "Enabled": ${KEYPOINT_NOTIFICATION_ENABLED},
        "Endpoint": "${KEYPOINT_NOTIFICATION_ENDPOINT}"
    },
    "ExperimentNotification": {
        "Enabled": ${EXPERIMENT_NOTIFICATION_ENABLED},
        "Endpoint": "${EXPERIMENT_NOTIFICATION_ENDPOINT}",
        "ComponentName": "${EXPERIMENT_NOTIFICATION_COMPONENT_NAME}"
    }
}